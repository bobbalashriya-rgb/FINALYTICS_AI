# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-example-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=financial_research_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# MarketPing MCP
MARKETPING_MCP_URL=https://mcp.marketping.in/mcp

# Embedding Provider Configuration (Phase 5)
# Options: "local" (deterministic offline hashing - default), "openai", or "gemini"
EMBEDDING_PROVIDER=local

# OpenAI Embeddings (required only if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Embeddings (required only if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=text-embedding-004

# LLM Provider Configuration (Phase 7: Qualitative Analysis)
# Options: "gemini" (default if key present), "openai", or "mock" (offline fallback)
LLM_PROVIDER=gemini

# Google Gemini LLM
# Uses GEMINI_API_KEY configured above
GEMINI_LLM_MODEL=gemini-2.5-flash

# OpenAI LLM
# Uses OPENAI_API_KEY configured above
OPENAI_LLM_MODEL=gpt-4o-mini
